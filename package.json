{
  "name": "algo-arena-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "dev:detached": "node dev.mjs --detached",
    "dev:vite": "vite --host 0.0.0.0",
    "dev:api": "node server.mjs",
    "validate:codeforces": "node scripts/validate-codeforces-tests.mjs",
    "generate:codeforces-tests": "node scripts/generate-codeforces-test-packs.mjs --all",
    "validate:codeforces-interactive": "node scripts/validate-codeforces-interactive-packs.mjs",
    "build": "npm run validate:codeforces && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^6.30.1",
    "vite": "latest"
  },
  "devDependencies": {}
}
