FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends g++ \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

RUN useradd --create-home --uid 10001 judge \
  && chown -R judge:judge /app

USER judge

ENV NODE_ENV=production \
    AI_API_PORT=3001 \
    JUDGE_CXX=/usr/bin/g++

EXPOSE 3001

CMD ["node", "server.mjs"]
